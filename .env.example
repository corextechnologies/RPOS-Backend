# Neon PostgreSQL connection (use the pooled or direct URL; sslmode=require for Neon)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Separate database/branch for the automated test suite (schema is created/dropped)
TEST_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME_test?sslmode=require

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ENV=development
# When ENV=development|dev|local|test, newly provisioned users get password Admin@1234.
# Production must use ENV=production (random passwords).
# Browser origins allowed to call this API (comma-separated). * = dev only.
CORS_ORIGINS=*
